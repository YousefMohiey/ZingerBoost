{
  "$schema": "https://raw.githubusercontent.com/nicklasxyz/tauri/tauri-v2/crates/tauri-config-schema/schema.json",
  "productName": "ZingerBoost",
  "version": "0.0.6",
  "identifier": "com.zingerboost.app",
  "build": {
    "frontendDist": "src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ZingerBoost",
        "width": 1280,
        "height": 850,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "decorations": false,
        "theme": "Dark",
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' tauri:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": ["English"],
        "license": null,
        "headerImage": null,
        "sidebarImage": null
      }
    },
    "shortDescription": "Windows System Optimizer",
    "longDescription": "ZingerBoost is a safe, reversible Windows optimization tool with 49 tweaks, system cleaner, service manager, and software installer.",
    "category": "Utility",
    "publisher": "YousefMohiey",
    "copyright": "Copyright 2024 YousefMohiey"
  }
}