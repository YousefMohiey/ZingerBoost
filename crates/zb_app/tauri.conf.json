{
  "$schema": "../../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../dist"
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "copyright": "2026 YousefMohiey",
    "targets": "all",
    "externalBin": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": ["en-US"]
      }
    },
    "longDescription": "",
    "shortDescription": "Safe Windows Optimization Utility"
  },
  "productName": "ZingerBoost",
  "version": "0.1.0",
  "identifier": "com.yousefmohiey.zingerboost",
  "plugins": {},
  "app": {
    "security": {
      "csp": null,
      "capabilities": ["default"]
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "resizable": true,
        "title": "ZingerBoost",
        "width": 1200,
        "minWidth": 900,
        "minHeight": 600,
        "center": true
      }
    ]
  }
}
